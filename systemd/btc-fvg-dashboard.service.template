[Unit]
Description=BTC FVG Momentum Dashboard
After=network.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_ROOT}}
Environment=PYTHONPATH={{PROJECT_ROOT}}
Environment=DASHBOARD_HOST=0.0.0.0
Environment=DASHBOARD_PORT=5556
ExecStart={{PYTHON}} -m src.fvg.dashboard
Restart=on-failure
RestartSec=10
StandardOutput=append:{{PROJECT_ROOT}}/logs/dashboard.log
StandardError=append:{{PROJECT_ROOT}}/logs/dashboard.log

[Install]
WantedBy=multi-user.target
