# Copy this file to .env and fill in your Bybit demo API credentials.
# Do not commit the real .env file.

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com

SYMBOL=BTCUSDT
INTERVAL=30
LEVERAGE=1

SUPERTREND_FACTOR=3.0
SUPERTREND_PERIOD=10
MOMENTUM_LOOKBACK=10
INITIAL_SL_POINTS=500
TRAIL_OFFSET_POINTS=500
TRAIL_ACTIVATION_POINTS=0
DIRECTION=both

RISK_PER_TRADE_PCT=1.0
TRADING_CAPITAL_PCT=20.0
HISTORY_BARS=300
POLL_SECONDS=10
