# Copy this file to .env and fill in your Bybit demo API credentials.
# Do not commit the real .env file.

BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_DEMO_BASE_URL=https://api-demo.bybit.com
BYBIT_PUBLIC_BASE_URL=https://api.bybit.com

SYMBOL=BTCUSDT
INTERVAL=30
LEVERAGE=1

SUPERTREND_FACTOR=3.0
SUPERTREND_PERIOD=10
MOMENTUM_LOOKBACK=10
INITIAL_SL_POINTS=500
TRAIL_OFFSET_POINTS=500
TRAIL_ACTIVATION_POINTS=0
DIRECTION=both

RISK_PER_TRADE_PCT=1.0
TRADING_CAPITAL_PCT=20.0
HISTORY_BARS=300
POLL_SECONDS=10

# --- Optional notifications ---
# Telegram: create a bot with @BotFather, get chat ID from @userinfobot or by messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP (optional). Leave blank to disable.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# --- Heartbeat ---
# Periodic "bot alive" status notification in seconds. Default 240 = 4 minutes.
# Set to 0 to disable.
HEARTBEAT_INTERVAL_SECONDS=240
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
